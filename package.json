{
  "name": "alef-assistant",
  "version": "0.5.16",
  "private": true,
  "description": "مساعد محلي بواجهة عربية وإضافة Chrome لقراءة أسئلة ألف وحلها مع التحقق",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "start:windows": "node --env-file-if-exists=.env scripts/windows-start.mjs",
    "token": "node --env-file-if-exists=.env scripts/show-token.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "check": "node scripts/check.mjs",
    "package": "python3 scripts/package.py"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "esbuild": "0.25.12",
    "mathlive": "0.110.0",
    "playwright": "1.61.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-select": "5.10.2"
  }
}
