# الوضع الافتراضي مجاني ومحلي عبر Ollama؛ لا يحتاج أي مفتاح API.
# على ويندوز استخدم START-WINDOWS.cmd دون إنشاء ملف .env.
SOLVER_PROVIDER=ollama
SOLVER_MODEL=qwen3:8b
SOLVER_BASE_URL=http://127.0.0.1:11434
SOLVER_TIMEOUT_MS=240000
# اختياري لملف تشغيل ويندوز: نموذج أخف وأسرع، ولا يحتاج مفتاحًا.
# SOLVER_LOCAL_MODEL=qwen3:4b
# اختياري: مسار مجلد الإعدادات المحلي. يُنشأ رمز اقتران عشوائي داخله.
# SOLVER_CONFIG_DIR=

# خدمة خارجية اختيارية فقط؛ لا تحتاجها للتشغيل المجاني:
# SOLVER_PROVIDER=openai
# SOLVER_MODEL=gpt-4.1-mini
# SOLVER_BASE_URL=https://api.openai.com/v1
# SOLVER_API_KEY=
